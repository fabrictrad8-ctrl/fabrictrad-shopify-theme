<div data-ft-shiprocket-pickup-settings hidden></div>
<style>.fts__pickup-form{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:14px;padding-top:14px;border-top:1px solid #e5e7eb}.fts__pickup-form label{display:grid;gap:5px;color:#475467;font-size:10px;font-weight:750}.fts__pickup-form input{min-height:38px;padding:0 9px;border:1px solid #cdd3da;border-radius:8px;background:#fff;color:#17202a}.fts__pickup-form .wide{grid-column:1/-1}.fts__pickup-status{margin-top:9px;padding:9px;border-radius:8px;background:#f8fafc;color:#667085;font-size:9px;line-height:1.5}@media(max-width:640px){.fts__pickup-form{grid-template-columns:1fr}.fts__pickup-form .wide{grid-column:auto}}</style>
<script>
(function(){
 async function init(){
  const workspace=document.querySelector('[data-ft-seller-workspace]'),host=document.getElementById('fts-pickup-address');if(!workspace||!host||host.dataset.pickupFormReady)return;if(!window.FabricTradAuth){setTimeout(init,100);return}host.dataset.pickupFormReady='1';
  try{
   const sb=await window.FabricTradAuth.getClient(),{data:{session}}=await sb.auth.getSession();if(!session)return;
   const [{data:seller},{data:profile}]=await Promise.all([sb.from('seller_profiles').select('id,seller_ref,display_name,legal_business_name,shiprocket_pickup_location,shiprocket_pickup_registered,shiprocket_pickup_synced_at,pickup_address').eq('user_id',session.user.id).maybeSingle(),sb.from('user_profiles').select('full_name,email,phone').eq('id',session.user.id).maybeSingle()]);if(!seller)return;const a=seller.pickup_address||{};
   const form=document.createElement('form');form.className='fts__pickup-form';form.innerHTML=`<label>Pickup nickname<input name="pickup_location" maxlength="36" value="${esc(seller.shiprocket_pickup_location||('FT-'+String(seller.seller_ref||seller.id).slice(-18)))}" required></label><label>Contact name<input name="name" value="${esc(a.name||seller.display_name||seller.legal_business_name||profile?.full_name||'')}" required></label><label>Email<input name="email" type="email" value="${esc(a.email||profile?.email||session.user.email||'')}" required></label><label>Mobile<input name="phone" inputmode="tel" value="${esc(a.phone||profile?.phone||'')}" required></label><label class="wide">Address line 1<input name="address" maxlength="80" value="${esc(a.line1||'')}" required></label><label class="wide">Address line 2<input name="address_2" maxlength="80" value="${esc(a.line2||'')}"></label><label>City<input name="city" value="${esc(a.city||'')}" required></label><label>State<input name="state" value="${esc(a.state||'')}" required></label><label>Pincode<input name="pincode" inputmode="numeric" maxlength="6" value="${esc(a.pincode||'')}" required></label><div class="wide"><button class="fts__primary" type="submit">${seller.shiprocket_pickup_registered?'Sync pickup with Shiprocket':'Register pickup with Shiprocket'}</button><div class="fts__pickup-status">${seller.shiprocket_pickup_registered?`Connected as <strong>${esc(seller.shiprocket_pickup_location||'pickup')}</strong>${seller.shiprocket_pickup_synced_at?' · last synced '+new Date(seller.shiprocket_pickup_synced_at).toLocaleString('en-IN'):''}.`:'Complete this once so paid marketplace orders can be booked from this seller address without re-entering it.'}</div></div>`;
   host.insertAdjacentElement('afterend',form);
   form.addEventListener('submit',async e=>{e.preventDefault();const button=form.querySelector('button[type=submit]'),fd=new FormData(form),payload=Object.fromEntries(fd.entries());button.disabled=true;button.textContent='Syncing with Shiprocket…';try{const {data:{session:s}}=await sb.auth.getSession(),r=await fetch('https://rdhfwlzhcvwjhkxhhpoo.supabase.co/functions/v1/shiprocket-seller-pickup',{method:'POST',headers:{Authorization:`Bearer ${s.access_token}`,apikey:'sb_publishable_Un2-RQfjGbIiXF3Mb2oGIA_p-Z1kMls','Content-Type':'application/json'},body:JSON.stringify(payload)}),p=await r.json();if(!r.ok)throw new Error(p.error||'Shiprocket pickup setup failed');alert(`Shiprocket pickup ready: ${p.pickup_location}`);location.reload()}catch(err){alert(err.message||'Shiprocket pickup setup failed');button.disabled=false;button.textContent='Sync pickup with Shiprocket'}});
  }catch(e){console.warn('Shiprocket pickup form unavailable',e)}
 }
 function esc(v){return String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
 document.readyState==='loading'?document.addEventListener('DOMContentLoaded',()=>setTimeout(init,100)):setTimeout(init,100);
})();
</script>
{% schema %}{"name":"Shiprocket pickup","tag":"section","class":"fabrictrad-shiprocket-pickup-settings","settings":[],"presets":[{"name":"Shiprocket pickup"}]}{% endschema %}