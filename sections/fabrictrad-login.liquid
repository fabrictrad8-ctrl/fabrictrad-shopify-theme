<style>.shopify-section-group-header-group,.shopify-section-group-footer-group{display:none!important}.ftlogin{min-height:100vh;display:grid;place-items:center;padding:28px;background:radial-gradient(circle at 18% 10%,rgba(234,88,12,.18),transparent 34rem),radial-gradient(circle at 85% 10%,rgba(15,118,110,.12),transparent 32rem),#07101d;color:#eaf0f7;font-family:Inter,system-ui,sans-serif}.ftlogin *{box-sizing:border-box}.ftlogin__shell{width:min(1040px,100%);display:grid;grid-template-columns:1.05fr .95fr;border:1px solid rgba(255,255,255,.10);border-radius:26px;overflow:hidden;background:rgba(12,20,34,.92);box-shadow:0 35px 100px rgba(0,0,0,.35)}.ftlogin__intro{padding:clamp(32px,6vw,64px);background:linear-gradient(145deg,rgba(234,88,12,.12),rgba(255,255,255,.02))}.ftlogin__brand{display:flex;align-items:center;gap:11px;font-weight:900;font-size:21px}.ftlogin__mark{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(135deg,#fb923c,#ea580c)}.ftlogin h1{margin:70px 0 18px;font-size:clamp(42px,5vw,66px);line-height:.95;letter-spacing:-.055em}.ftlogin__intro p{max-width:520px;color:#9badbf;line-height:1.7}.ftlogin__rules{display:grid;gap:10px;margin-top:34px}.ftlogin__rules span{display:flex;gap:10px;align-items:center;color:#c8d3df;font-size:13px}.ftlogin__rules i{width:8px;height:8px;border-radius:50%;background:#4fd1c5}.ftlogin__panel{padding:clamp(28px,5vw,54px);background:#fff;color:#0f172a}.ftlogin__eyebrow{margin:0 0 8px;color:#ea580c;font-size:12px;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.ftlogin__panel h2{margin:0 0 8px;font-size:30px;letter-spacing:-.04em}.ftlogin__sub{margin:0 0 25px;color:#64748b;line-height:1.55}.ftlogin form{display:grid;gap:14px}.ftlogin label{display:grid;gap:7px;font-size:13px;font-weight:750;color:#334155}.ftlogin input{width:100%;padding:13px 14px;border:1px solid #cbd5e1!important;border-radius:11px!important;background:#fff!important;color:#0f172a!important;font:inherit}.ftlogin button{min-height:46px;border-radius:11px;border:1px solid #dbe3ec;background:#fff;color:#0f172a;font-weight:850;cursor:pointer;display:flex;align-items:center;justify-content:center}.ftlogin__primary{border:0!important;background:linear-gradient(135deg,#f97316,#ea580c)!important;color:#fff!important}.ftlogin__google{gap:10px}.ftlogin__google b{font-size:18px;color:#4285f4}.ftlogin__or{display:flex;align-items:center;gap:12px;margin:18px 0;color:#94a3b8;font-size:11px;text-transform:uppercase;letter-spacing:.1em}.ftlogin__or:before,.ftlogin__or:after{content:'';height:1px;background:#e2e8f0;flex:1}.ftlogin__msg{margin:0 0 16px;padding:12px 13px;border-radius:10px;background:#f0f9ff;color:#075985;font-size:13px;line-height:1.45}.ftlogin__msg[data-type=error]{background:#fef2f2;color:#991b1b}.ftlogin__msg[data-type=success]{background:#f0fdf4;color:#166534}.ftlogin__bottom{margin-top:20px;display:grid;gap:9px;color:#64748b;font-size:13px}.ftlogin__bottom a{color:#ea580c;font-weight:800;text-decoration:none}.ftlogin__admin{margin-top:24px;padding-top:18px;border-top:1px solid #e2e8f0;font-size:12px;color:#64748b}.ftlogin__admin a{color:#0f172a;font-weight:850}.ftlogin :focus-visible{outline:3px solid rgba(249,115,22,.35);outline-offset:2px}@media(max-width:800px){.ftlogin__shell{grid-template-columns:1fr}.ftlogin__intro{padding:30px}.ftlogin h1{margin-top:34px}.ftlogin__panel{padding:30px}}</style>
<main class="ftlogin"><div class="ftlogin__shell"><section class="ftlogin__intro"><div class="ftlogin__brand"><span class="ftlogin__mark">F</span>FabricTrad</div><h1>Fabric marketplace.</h1><p>This sign-in is only for FabricTrad Buyer accounts. Seller accounts use Seller Centre, with a separate identity and separate workspace.</p><div class="ftlogin__rules"><span><i></i>Buyer account → marketplace and buyer dashboard</span><span><i></i>Seller account → Seller Centre only</span><span><i></i>Administrator → isolated admin portal</span></div></section><section class="ftlogin__panel"><p class="ftlogin__eyebrow">Buyer account</p><h2 id="ftlogin-title">Buyer sign in</h2><p class="ftlogin__sub" id="ftlogin-sub">Use the email and password attached to your FabricTrad Buyer account.</p><div id="ftlogin-msg" class="ftlogin__msg" role="status" aria-live="polite" hidden></div><form id="ftlogin-form"><label>Email<input id="ftlogin-email" type="email" autocomplete="email" required></label><label>Password<input id="ftlogin-password" type="password" autocomplete="current-password" minlength="6" required></label><button class="ftlogin__primary" type="submit">Sign in as Buyer</button></form><div class="ftlogin__or">Buyer login</div><button id="ftlogin-google" class="ftlogin__google" type="button"><b>G</b> Continue with Google as Buyer</button><div class="ftlogin__bottom"><span>New buyer? <a href="#" id="ftlogin-create">Create Buyer account</a></span><span>Selling on FabricTrad? <a href="/pages/seller-portal">Open Seller Centre</a></span></div><div class="ftlogin__admin">Administrator? <a href="/pages/fabrictrad-admin">Use the Admin portal</a></div></section></div></main>
<script>
document.addEventListener('DOMContentLoaded',async function(){
 const VERSION='20260828-primary-role-v1',SELLER='/pages/seller-portal',ADMIN='/pages/fabrictrad-admin';
 const q=new URLSearchParams(location.search),nextRaw=q.get('next')||'/collections/fabrictrad-catalogue';
 const msg=document.getElementById('ftlogin-msg'),form=document.getElementById('ftlogin-form'),title=document.getElementById('ftlogin-title'),sub=document.getElementById('ftlogin-sub');let signup=q.get('signup')==='buyer';
 function tell(text,type='info'){msg.textContent=text;msg.dataset.type=type;msg.hidden=!text} async function sb(){return window.FabricTradAuth.getClient()} function isAdmin(role){return role==='super_admin'||role==='admin_staff'}
 function safeBuyerTarget(raw){try{const u=new URL(raw,location.origin);if(u.origin!==location.origin)return'/collections/fabrictrad-catalogue';if(u.pathname.startsWith('/pages/seller-portal')||u.pathname.startsWith('/pages/fabrictrad-admin'))return'/collections/fabrictrad-catalogue';if(u.pathname==='/pages/buyer-dashboard')u.searchParams.set('ftv',VERSION);return u.pathname+u.search+u.hash}catch{return'/collections/fabrictrad-catalogue'}} const next=safeBuyerTarget(nextRaw);
 async function profile(client,session,repair){let r=await client.from('user_profiles').select('role,is_active,can_buy,can_sell').eq('id',session.user.id).maybeSingle();if(r.error)throw r.error;if(r.data)return r.data;const meta=session.user?.user_metadata?.role||session.user?.app_metadata?.role||null;if(meta==='seller')return{role:'seller',is_active:true,can_buy:false,can_sell:true};if(isAdmin(meta))return{role:meta,is_active:true,can_buy:false,can_sell:false};if(!repair)return null;const e=await client.rpc('ensure_current_account_profile',{p_requested_role:'buyer'});if(e.error)throw e.error;r=await client.from('user_profiles').select('role,is_active,can_buy,can_sell').eq('id',session.user.id).maybeSingle();if(r.error)throw r.error;return r.data||null}
 async function route(client,session){const p=await profile(client,session,true),role=p?.role||session.user?.user_metadata?.role||session.user?.app_metadata?.role||null;if(isAdmin(role)){await client.auth.signOut().catch(()=>{});location.replace(ADMIN);return}if(role==='seller'){location.replace(SELLER);return}if(!p||p.is_active!==true||role!=='buyer'||p.can_buy===false){await client.auth.signOut().catch(()=>{});throw new Error('This is not an active FabricTrad Buyer account.')}location.replace(next)}
 function renderSignup(){signup=true;title.textContent='Create Buyer account';sub.textContent='Create a Buyer identity for marketplace shopping. Seller registration uses a separate Seller account.';document.getElementById('ftlogin-password').autocomplete='new-password';form.querySelector('button').textContent='Create Buyer account';document.getElementById('ftlogin-create').textContent='Back to Buyer sign in'}
 document.getElementById('ftlogin-create').addEventListener('click',e=>{e.preventDefault();if(signup)location.href='/pages/login?next='+encodeURIComponent(next);else renderSignup()});if(signup)renderSignup();
 form.addEventListener('submit',async e=>{e.preventDefault();const client=await sb(),email=document.getElementById('ftlogin-email').value.trim().toLowerCase(),password=document.getElementById('ftlogin-password').value;if(!email||!password)return;tell(signup?'Creating Buyer account…':'Signing in to Buyer account…');try{if(signup){const{data,error}=await client.auth.signUp({email,password,options:{data:{role:'buyer'},emailRedirectTo:location.origin+'/pages/login?next='+encodeURIComponent(next)}});if(error)throw error;if(data.session)await route(client,data.session);else tell('Buyer account created. Confirm your email, then return here to sign in.','success');return}const{data,error}=await client.auth.signInWithPassword({email,password});if(error)throw error;await route(client,data.session)}catch(err){tell(err?.message||'Buyer sign-in failed.','error')}});
 document.getElementById('ftlogin-google').addEventListener('click',async()=>{const client=await sb();tell('Opening Google Buyer sign-in…');const redirect=new URL(location.origin+'/pages/login');redirect.searchParams.set('oauth','buyer');redirect.searchParams.set('next',next);const{error}=await client.auth.signInWithOAuth({provider:'google',options:{redirectTo:redirect.toString(),queryParams:{prompt:'select_account'}}});if(error)tell(error.message,'error')});
 window.addEventListener('pageshow',event=>{if(event.persisted)location.reload()});try{const client=await sb();const{data:{session}}=await client.auth.getSession();if(session)await route(client,session)}catch(err){tell(err?.message||'Unable to continue.','error')}
});
</script>
