<style>
body:has([data-ft-login]) #header-group,body:has([data-ft-login]) footer{display:none!important}body:has([data-ft-login]) #MainContent{padding:0!important;margin:0!important;max-width:none!important}.ft-login-role{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:5px;border:1px solid #e2e8f0;border-radius:12px;background:#f8fafc;margin:18px 0}.ft-login-role button{min-height:42px;border:0;border-radius:9px;background:transparent;color:#64748b;font-weight:800;cursor:pointer}.ft-login-role button.is-active{background:#fff;color:#111827;box-shadow:0 1px 4px rgba(15,23,42,.1)}.ft-login-form{display:grid;gap:14px}.ft-login-form label{display:grid;gap:6px;font-size:13px;font-weight:750;color:#475569}.ft-login-form input{padding:0 13px}.ft-login-row{display:flex;align-items:center;justify-content:space-between;gap:10px}.ft-login-link{border:0;background:none;color:#c2410c;font-weight:750;cursor:pointer;padding:4px 0}.ft-login-divider{display:flex;align-items:center;gap:10px;color:#94a3b8;font-size:12px;margin:3px 0}.ft-login-divider:before,.ft-login-divider:after{content:'';height:1px;background:#e2e8f0;flex:1}.ft-login-google{width:100%;display:flex;align-items:center;justify-content:center;gap:10px;padding:0 14px;font-weight:800;cursor:pointer}.ft-login-google svg{width:18px;height:18px}.ft-login-message{padding:11px 12px;border-radius:10px;background:#eff6ff;color:#1e40af;font-size:13px;line-height:1.5}.ft-login-message[data-type=error]{background:#fef2f2;color:#991b1b}.ft-login-message[data-type=success]{background:#f0fdf4;color:#166534}.ft-login-otp{display:grid;grid-template-columns:1fr auto;gap:8px}.ft-login-otp button{padding:0 15px}.ft-login-back{display:inline-flex;margin-top:14px}.ft-login-admin-email{padding:11px 12px;border:1px solid #e2e8f0;border-radius:10px;background:#f8fafc;color:#334155;font-weight:750}.ft-login-footer{text-align:center;margin-top:18px;color:#64748b;font-size:12px}.ft-login-footer button{border:0;background:none;color:#c2410c;font-weight:800;cursor:pointer}.ft-auth-card-wrap{position:relative}.ft-auth-card [hidden]{display:none!important}@media(max-width:640px){.ft-login-role{margin-top:14px}}
</style>
<div class="ft-root ft-auth-page" data-ft-login>
  <div class="ft-auth-stage">
    <section class="ft-auth-visual" aria-label="FabricTrad commerce platform">
      <a href="/" class="ft-auth-brandline"><span style="display:grid;width:34px;height:34px;place-items:center;border-radius:11px;background:#e9570b;color:white;font-weight:900">F</span> FabricTrad</a>
      <p class="ft-auth-eyebrow">India's textile commerce network</p>
      <h1 class="ft-auth-title">Buy and sell textile products with one focused workspace.</h1>
      <p class="ft-auth-subtitle">Use one FabricTrad account across the workspaces enabled for you. Buyer and seller access are routed by verified account capabilities.</p>
      <div class="ft-auth-graphic" aria-hidden="true"><span class="ft-auth-swatch"></span><span class="ft-auth-swatch"></span><span class="ft-auth-swatch"></span><span class="ft-auth-node n1"></span><span class="ft-auth-node n2"></span><span class="ft-auth-node n3"></span></div>
      <div class="ft-auth-flow"><div class="ft-auth-flow-card"><strong>1</strong><span>Sign in with your FabricTrad account</span></div><div class="ft-auth-flow-card"><strong>2</strong><span>We verify your active account permissions</span></div><div class="ft-auth-flow-card"><strong>3</strong><span>Open the buyer or seller workspace you selected</span></div></div>
    </section>
    <div class="ft-auth-card-wrap">
      <section class="ft-auth-card" id="ft-login-card">
        <div id="ft-login-normal">
          <p class="ft-auth-kicker">Secure account access</p><h2 style="margin:10px 0 6px">Sign in to FabricTrad</h2><p class="ft-auth-copy" style="margin:0 0 16px">Use the same credentials you used on FabricTrad before the Shopify migration.</p>
          <div class="ft-login-role" role="tablist"><button type="button" data-role="buyer" class="is-active">Buyer</button><button type="button" data-role="seller">Seller</button></div>
          <div id="ft-login-message" class="ft-login-message" role="status" aria-live="polite" hidden></div>
          <form id="ft-password-login" class="ft-login-form">
            <label>Email<input id="ft-login-email" class="ft-auth-field" type="email" autocomplete="email" required></label>
            <label>Password<input id="ft-login-password" class="ft-auth-field" type="password" autocomplete="current-password" minlength="6" required></label>
            <div class="ft-login-row"><span></span><button id="ft-forgot" class="ft-login-link" type="button">Forgot password?</button></div>
            <button class="ft-auth-submit" type="submit" style="min-height:48px;border:0;cursor:pointer">Sign in</button>
          </form>
          <div id="ft-google-area"><div class="ft-login-divider">or</div><button id="ft-google" class="ft-auth-google ft-login-google" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.92h5.38a4.6 4.6 0 0 1-2 3.02v2.54h3.24c1.9-1.75 2.98-4.33 2.98-7.41z"/><path fill="#34A853" d="M12 22c2.7 0 4.97-.9 6.62-2.36l-3.24-2.54c-.9.6-2.05.96-3.38.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.62A10 10 0 0 0 12 22z"/><path fill="#FBBC05" d="M6.39 13.93A6 6 0 0 1 6.08 12c0-.67.11-1.32.31-1.93V7.45H3.04A10 10 0 0 0 2 12c0 1.61.38 3.14 1.04 4.55l3.35-2.62z"/><path fill="#EA4335" d="M12 5.94c1.47 0 2.78.5 3.82 1.49l2.87-2.87A9.62 9.62 0 0 0 12 2a10 10 0 0 0-8.96 5.45l3.35 2.62C7.18 7.7 9.39 5.94 12 5.94z"/></svg>Continue with Google</button><p class="ft-auth-muted" style="font-size:12px;margin:8px 0 0;text-align:center">Google sign-in is available for buyer accounts.</p></div>
          <div class="ft-login-footer">New to FabricTrad? <button id="ft-show-signup" type="button">Create an account</button></div>
          <div class="ft-login-footer"><button id="ft-show-admin" type="button" style="color:#64748b">Administrator sign in</button></div>
        </div>

        <div id="ft-signup" hidden><p class="ft-auth-kicker">Create account</p><h2 style="margin:10px 0 6px">Join FabricTrad</h2><p class="ft-auth-copy">Create one FabricTrad account. Buyer access is available immediately; seller access continues through Seller Centre verification.</p><div class="ft-login-role"><button type="button" data-signup-role="buyer" class="is-active">Buyer</button><button type="button" data-signup-role="seller">Seller</button></div><div id="ft-signup-message" class="ft-login-message" hidden></div><form id="ft-signup-form" class="ft-login-form"><label>Email<input id="ft-signup-email" class="ft-auth-field" type="email" autocomplete="email" required></label><label>Password<input id="ft-signup-password" class="ft-auth-field" type="password" autocomplete="new-password" minlength="8" required></label><label>Confirm password<input id="ft-signup-confirm" class="ft-auth-field" type="password" autocomplete="new-password" minlength="8" required></label><button class="ft-auth-submit" type="submit" style="min-height:48px;border:0;cursor:pointer">Create account</button></form><button class="ft-login-link ft-login-back" type="button" data-back>← Back to sign in</button></div>

        <div id="ft-recovery" hidden><p class="ft-auth-kicker">Password recovery</p><h2 style="margin:10px 0 6px">Reset with email OTP</h2><p class="ft-auth-copy">We'll send a one-time code to the email registered to your buyer or seller account.</p><div id="ft-recovery-message" class="ft-login-message" hidden></div><div id="ft-recovery-request"><form id="ft-recovery-request-form" class="ft-login-form"><label>Account email<input id="ft-recovery-email" class="ft-auth-field" type="email" autocomplete="email" required></label><button class="ft-auth-submit" type="submit" style="min-height:48px;border:0;cursor:pointer">Send OTP</button></form></div><div id="ft-recovery-verify" hidden><form id="ft-recovery-verify-form" class="ft-login-form"><label>6-digit OTP<input id="ft-recovery-otp" class="ft-auth-field" inputmode="numeric" autocomplete="one-time-code" maxlength="8" required></label><button class="ft-auth-submit" type="submit" style="min-height:48px;border:0;cursor:pointer">Verify OTP</button></form><button id="ft-recovery-resend" class="ft-login-link" type="button">Resend OTP</button></div><div id="ft-recovery-password" hidden><form id="ft-recovery-password-form" class="ft-login-form"><label>New password<input id="ft-new-password" class="ft-auth-field" type="password" autocomplete="new-password" minlength="8" required></label><label>Confirm new password<input id="ft-new-password-confirm" class="ft-auth-field" type="password" autocomplete="new-password" minlength="8" required></label><button class="ft-auth-submit" type="submit" style="min-height:48px;border:0;cursor:pointer">Update password</button></form></div><button class="ft-login-link ft-login-back" type="button" data-back>← Back to sign in</button></div>

        <div id="ft-admin-login" hidden><p class="ft-auth-kicker">Administrator</p><h2 style="margin:10px 0 6px">Admin OTP sign in</h2><p class="ft-auth-copy">Administrator access is restricted to the configured FabricTrad admin email and requires an email OTP.</p><div id="ft-admin-message" class="ft-login-message" hidden></div><div class="ft-admin-email ft-login-admin-email">fabrictrad8@gmail.com</div><div id="ft-admin-request"><button id="ft-admin-send" class="ft-auth-submit" type="button" style="min-height:48px;border:0;cursor:pointer;margin-top:14px">Send admin OTP</button></div><form id="ft-admin-verify" class="ft-login-form" hidden style="margin-top:14px"><label>Admin OTP<input id="ft-admin-otp" class="ft-auth-field" inputmode="numeric" autocomplete="one-time-code" maxlength="8" required></label><button class="ft-auth-submit" type="submit" style="min-height:48px;border:0;cursor:pointer">Verify & open Admin</button></form><button class="ft-login-link ft-login-back" type="button" data-back>← Back to buyer/seller sign in</button></div>
      </section>
    </div>
  </div>
</div>
<script>
(function(){
const ADMIN='fabrictrad8@gmail.com';let sb=null,role='buyer',signupRole='buyer',recoveryEmail='';
const $=id=>document.getElementById(id),show=(id,on=true)=>{const n=$(id);if(n)n.hidden=!on},msg=(id,text,type='info')=>{const n=$(id);if(!n)return;n.textContent=text;n.dataset.type=type;n.hidden=!text};
function roleButtons(){document.querySelectorAll('[data-role]').forEach(b=>b.classList.toggle('is-active',b.dataset.role===role));document.querySelectorAll('[data-signup-role]').forEach(b=>b.classList.toggle('is-active',b.dataset.signupRole===signupRole));show('ft-google-area',role==='buyer')}
function panel(name){['ft-login-normal','ft-signup','ft-recovery','ft-admin-login'].forEach(id=>show(id,id===name));}
async function profile(){let {data:p}=await sb.from('user_profiles').select('id,email,role,is_active,can_buy,can_sell').eq('id',(await sb.auth.getUser()).data.user?.id||'').maybeSingle();return p||null}
function safeBuyerNext(next){if(!next||!next.startsWith('/')||next.startsWith('//'))return '/pages/buyer-dashboard';if(next.startsWith('/pages/seller-portal')||next.startsWith('/pages/fabrictrad-admin')||next.startsWith('/pages/login'))return '/pages/buyer-dashboard';return next}
function destination(p,next){if(!p||p.is_active!==true)return null;if(p.role==='super_admin'||p.role==='admin_staff')return '/pages/fabrictrad-admin';if(role==='seller'&&p.can_sell===true)return '/pages/seller-portal';if(role==='buyer'&&p.can_buy===true)return safeBuyerNext(next);if(p.can_buy===true)return safeBuyerNext(next);if(p.can_sell===true)return '/pages/seller-portal';return null}
async function routeSession(next){let p=await profile();if(!p){const {data:{user}}=await sb.auth.getUser();const requested=user?.app_metadata?.provider==='google'?'buyer':role;const ensured=await sb.rpc('ensure_current_account_profile',{p_requested_role:requested});if(ensured.error)throw ensured.error;p=await profile()}const dest=destination(p,next);if(dest){location.replace(dest);return true}if(p&&p.is_active!==true)throw new Error('This FabricTrad account is not active.');throw new Error(role==='seller'?'Seller access is not enabled for this account.':'Buyer access is not enabled for this account.')}
async function start(){sb=await window.FabricTradAuth.getClient();const q=new URLSearchParams(location.search);const requested=q.get('role');if(['buyer','seller'].includes(requested))role=requested;if(requested==='admin')panel('ft-admin-login');else panel('ft-login-normal');roleButtons();const {data:{session}}=await sb.auth.getSession();if(session&&requested!=='admin'&&q.get('recovery')!=='1'){await routeSession(q.get('next'));}}
function wire(){
document.querySelectorAll('[data-role]').forEach(b=>b.onclick=()=>{role=b.dataset.role;roleButtons()});document.querySelectorAll('[data-signup-role]').forEach(b=>b.onclick=()=>{signupRole=b.dataset.signupRole;roleButtons()});document.querySelectorAll('[data-back]').forEach(b=>b.onclick=()=>{panel('ft-login-normal');roleButtons()});
$('ft-show-signup').onclick=()=>{signupRole=role;panel('ft-signup');roleButtons()};$('ft-show-admin').onclick=()=>panel('ft-admin-login');$('ft-forgot').onclick=()=>{recoveryEmail=$('ft-login-email').value.trim();$('ft-recovery-email').value=recoveryEmail;panel('ft-recovery');msg('ft-recovery-message','')};
$('ft-password-login').onsubmit=async e=>{e.preventDefault();msg('ft-login-message','Signing in…');const email=$('ft-login-email').value.trim().toLowerCase(),password=$('ft-login-password').value;try{const {error}=await sb.auth.signInWithPassword({email,password});if(error)throw error;const p=await profile();if(p?.role==='super_admin'||p?.role==='admin_staff'){await sb.auth.signOut();panel('ft-admin-login');msg('ft-admin-message','Administrator accounts must use email OTP.','error');return}await routeSession(new URLSearchParams(location.search).get('next'))}catch(error){msg('ft-login-message',error.message||'Sign in failed.','error')}};
$('ft-google').onclick=async()=>{msg('ft-login-message','Opening Google sign in…');const {error}=await sb.auth.signInWithOAuth({provider:'google',options:{redirectTo:location.origin+'/pages/login?role=buyer&oauth=1'}});if(error)msg('ft-login-message',error.message,'error')};
$('ft-signup-form').onsubmit=async e=>{e.preventDefault();const email=$('ft-signup-email').value.trim().toLowerCase(),password=$('ft-signup-password').value,confirm=$('ft-signup-confirm').value;if(email===ADMIN){msg('ft-signup-message','Administrator accounts cannot be created here.','error');return}if(password!==confirm){msg('ft-signup-message','Passwords do not match.','error');return}msg('ft-signup-message','Creating your account…');const {data,error}=await sb.auth.signUp({email,password,options:{emailRedirectTo:location.origin+'/pages/login?role='+signupRole,data:{role:signupRole,account_role:signupRole}}});if(error){msg('ft-signup-message',error.message,'error');return}if(data.session){const ensured=await sb.rpc('ensure_current_account_profile',{p_requested_role:signupRole});if(ensured.error){msg('ft-signup-message',ensured.error.message,'error');return}role=signupRole;await routeSession(null);return}msg('ft-signup-message','Account created. Confirm your email if requested, then sign in.','success')};
async function sendRecovery(){const email=$('ft-recovery-email').value.trim().toLowerCase();if(!email){msg('ft-recovery-message','Enter your account email.','error');return}if(email===ADMIN){msg('ft-recovery-message','Admin password recovery is disabled. Use Administrator sign in with OTP.','error');return}recoveryEmail=email;msg('ft-recovery-message','Sending one-time code…');const {error}=await sb.auth.signInWithOtp({email,options:{shouldCreateUser:false}});if(error){msg('ft-recovery-message',error.message,'error');return}show('ft-recovery-request',false);show('ft-recovery-verify',true);msg('ft-recovery-message','If this email belongs to a FabricTrad buyer or seller, a one-time code has been sent.','success')}
$('ft-recovery-request-form').onsubmit=async e=>{e.preventDefault();await sendRecovery()};$('ft-recovery-resend').onclick=sendRecovery;
$('ft-recovery-verify-form').onsubmit=async e=>{e.preventDefault();const token=$('ft-recovery-otp').value.trim();msg('ft-recovery-message','Verifying code…');const {error}=await sb.auth.verifyOtp({email:recoveryEmail,token,type:'email'});if(error){msg('ft-recovery-message',error.message,'error');return}const p=await profile();if(!p||(!p.can_buy&&!p.can_sell)){await sb.auth.signOut();msg('ft-recovery-message','This recovery path is only for buyer and seller accounts.','error');return}show('ft-recovery-verify',false);show('ft-recovery-password',true);msg('ft-recovery-message','OTP verified. Choose a new password.','success')};
$('ft-recovery-password-form').onsubmit=async e=>{e.preventDefault();const a=$('ft-new-password').value,b=$('ft-new-password-confirm').value;if(a.length<8){msg('ft-recovery-message','Use at least 8 characters.','error');return}if(a!==b){msg('ft-recovery-message','Passwords do not match.','error');return}const {error}=await sb.auth.updateUser({password:a});if(error){msg('ft-recovery-message',error.message,'error');return}await sb.auth.signOut();panel('ft-login-normal');$('ft-login-email').value=recoveryEmail;msg('ft-login-message','Password updated. Sign in with your new password.','success')};
$('ft-admin-send').onclick=async()=>{msg('ft-admin-message','Sending administrator OTP…');const {error}=await sb.auth.signInWithOtp({email:ADMIN,options:{shouldCreateUser:false}});if(error){msg('ft-admin-message',error.message,'error');return}show('ft-admin-request',false);show('ft-admin-verify',true);msg('ft-admin-message','OTP sent to the FabricTrad administrator email.','success')};
$('ft-admin-verify').onsubmit=async e=>{e.preventDefault();const token=$('ft-admin-otp').value.trim();msg('ft-admin-message','Verifying administrator OTP…');const {error}=await sb.auth.verifyOtp({email:ADMIN,token,type:'email'});if(error){msg('ft-admin-message',error.message,'error');return}const p=await profile();if(!p||!['super_admin','admin_staff'].includes(p.role)||String(p.email||'').toLowerCase()!==ADMIN){await sb.auth.signOut();msg('ft-admin-message','This account is not authorised for FabricTrad administration.','error');return}location.replace('/pages/fabrictrad-admin')};
}
function boot(){if(!window.FabricTradAuth){setTimeout(boot,60);return}wire();start().catch(e=>msg('ft-login-message',e.message||'Unable to start sign in.','error'))}boot();
})();
</script>
{% schema %}{"name":"FabricTrad login","tag":"section","class":"fabrictrad-login","settings":[],"presets":[{"name":"FabricTrad login"}]}{% endschema %}
