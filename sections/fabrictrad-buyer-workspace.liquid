<div id="ftb-loading" class="ftb ftb__loading"><div><div class="ftb__spinner"></div><p>Preparing your buyer workspace…</p></div></div>
<section class="ft-root ft-admin-shell ft-buyer-account ftb" data-ft-buyer-workspace hidden>
  <header class="ft-admin-header ftb__header"><button id="ftb-menu" class="ftb__icon ftb__mobile-menu" type="button" aria-label="Open buyer navigation">☰</button><div class="ftb__head-title"><strong id="ftb-active-title">Your account</strong><span id="ftb-active-desc">Orders and buying shortcuts</span></div><form id="ftb-search" class="ftb__search"><span>⌕</span><input id="ftb-search-input" type="search" placeholder="Search FabricTrad products and suppliers"><button type="submit">Search</button></form><div class="ftb__head-actions"><a class="ftb__head-link" href="/collections/fabrictrad-catalogue">Shop</a><a class="ftb__icon" href="/cart" aria-label="Cart">🛒<span id="ftb-cart-count" class="ftb__badgecount" hidden>0</span></a><button id="ftb-notification-button" class="ftb__icon hide-mobile" type="button" aria-label="Notifications">🔔</button><button id="ftb-profile-button" class="ftb__icon" type="button" aria-label="Profile">👤</button></div></header>
  <div class="ftb__body"><aside id="ftb-sidebar" class="ft-admin-sidebar ftb__sidebar"><div class="ftb__sidebar-inner"><a href="/collections/fabrictrad-catalogue" class="ftb__brand"><span class="ftb__brandmark">F</span><span><strong>FabricTrad</strong><span>Buyer account</span></span></a><nav class="ftb__nav" aria-label="Buyer navigation"><div class="ftb__navgroup"><p class="ftb__navgroup-title">Purchases</p><button class="is-active" data-tab="overview"><span class="ftb__nav-icon">⌂</span>Your account</button><button data-tab="orders"><span class="ftb__nav-icon">▣</span>Your orders</button><button data-tab="tracking"><span class="ftb__nav-icon">🚚</span>Track packages</button><button data-tab="cart"><span class="ftb__nav-icon">🛒</span>Cart <span id="ftb-nav-cart-count" class="ftb__badgecount" hidden>0</span></button></div><div class="ftb__navgroup"><p class="ftb__navgroup-title">Sourcing</p><button data-tab="requirements"><span class="ftb__nav-icon">◉</span>Sourcing requests</button><button data-tab="disputes"><span class="ftb__nav-icon">✉</span>Messages & disputes</button></div><div class="ftb__navgroup"><p class="ftb__navgroup-title">Settings</p><button data-tab="notifications"><span class="ftb__nav-icon">🔔</span>Notifications <span id="ftb-unread-count" class="ftb__badgecount" hidden>0</span></button><button data-tab="account"><span class="ftb__nav-icon">●</span>Profile & addresses</button></div></nav><div class="ftb__sidebar-bottom"><a href="/collections/fabrictrad-catalogue">▦ Browse marketplace</a><button id="ftb-signout" class="danger" type="button">↪ Sign out</button></div></div></aside><div id="ftb-overlay" class="ftb__mobile-overlay" hidden></div>
    <main class="ft-admin-main ftb__main"><div class="ftb__container"><div id="ftb-alert" class="ftb__alert" hidden></div>
      <section data-panel="overview"><div class="ftb__pagehead"><div><p style="margin:0;color:#667085;font-size:11px;font-weight:800">Your account</p><h1 id="ftb-greeting">Buyer dashboard</h1><p>Manage purchases and get back to shopping quickly.</p></div><div class="ftb__actions"><a class="ftb__primary" href="/collections/fabrictrad-catalogue">Continue shopping →</a><button class="ftb__secondary" data-go="orders">Orders</button></div></div><div id="ftb-overview-tiles" class="ftb__tiles"></div><div id="ftb-stats" class="ftb__stats"></div><div class="ftb__grid2"><article class="ft-shopify-card ftb__card"><div class="ftb__cardhead"><div><h2>Recent orders</h2><p>Catalogue and Shopify purchasing</p></div><button data-go="orders">View all</button></div><div id="ftb-recent-orders" class="ftb__list"></div></article><article class="ft-shopify-card ftb__card"><div class="ftb__cardhead"><div><h2>Shipments in transit</h2><p>Live seller shipment records</p></div><button data-go="tracking">Track all</button></div><div id="ftb-active-shipments" class="ftb__list"></div></article></div></section>
      <section data-panel="orders" hidden><div class="ftb__pagehead"><div><h1>Your orders</h1><p>Payment, invoices and order status across FabricTrad purchasing.</p></div><button id="ftb-refresh-orders" class="ftb__secondary">Refresh</button></div><div id="ftb-order-filters" class="ftb__filters"><button class="is-active" data-order-filter="all">All</button><button data-order-filter="pending">Pending</button><button data-order-filter="paid">Paid</button><button data-order-filter="shipped">Shipped</button><button data-order-filter="delivered">Delivered</button><button data-order-filter="cancelled">Cancelled / refunded</button></div><div class="ftb__tablewrap"><table><thead><tr><th>Order</th><th>Product / source</th><th>Status</th><th>Payment</th><th>Total</th><th>Created</th></tr></thead><tbody id="ftb-orders-body"></tbody></table></div><div id="ftb-orders-empty" class="ftb__empty" hidden>No orders found.</div></section>
      <section data-panel="tracking" hidden><div class="ftb__pagehead"><div><h1>Track packages</h1><p>Shipment and delivery progress for your paid orders.</p></div></div><article class="ft-shopify-card ftb__card"><div id="ftb-shipments"></div><div id="ftb-shipments-empty" class="ftb__empty" hidden>No shipment records yet. Tracking appears once a seller dispatches a paid order.</div></article></section>
      <section data-panel="cart" hidden><div class="ftb__pagehead"><div><h1>Cart</h1><p>Review Shopify cart items before checkout.</p></div><a class="ftb__primary" href="/cart">Open full cart →</a></div><article class="ft-shopify-card ftb__card"><div id="ftb-cart-list"></div><div id="ftb-cart-empty" class="ftb__empty" hidden>Your cart is empty. <a href="/collections/fabrictrad-catalogue">Browse marketplace</a></div></article></section>
      <section data-panel="requirements" hidden><div class="ftb__pagehead"><div><h1>Sourcing requests</h1><p>Tell verified sellers what textile you need, your quantity, budget and deadline.</p></div><button id="ftb-toggle-requirement" class="ftb__primary">New sourcing request</button></div><form id="ftb-requirement-form" class="ft-shopify-card ftb__card ftb__form" hidden><label>Request title<input name="title" required maxlength="160"></label><label>Category<input name="category" placeholder="Cotton, silk, sarees…"></label><label>Quantity<input name="quantity" placeholder="e.g. 200 metres"></label><label>Budget<input name="budget" placeholder="e.g. ₹80,000"></label><label>Deadline<input name="deadline" type="date"></label><label class="ftb__wide">Description<textarea name="description" rows="4" required></textarea></label><div class="ftb__wide ftb__actions"><button class="ftb__primary" type="submit">Post requirement</button><button id="ftb-cancel-requirement" class="ftb__secondary" type="button">Cancel</button></div></form><article class="ft-shopify-card ftb__card" style="margin-top:12px"><div id="ftb-requirements"></div><div id="ftb-requirements-empty" class="ftb__empty" hidden>No sourcing requests yet.</div></article></section>
      <section data-panel="disputes" hidden><div class="ftb__pagehead"><div><h1>Messages & disputes</h1><p>Keep support and seller conversations connected to the relevant case.</p></div></div><div id="ftb-message-layout" class="ftb__message-layout"><aside id="ftb-dispute-list" class="ftb__threads"></aside><div class="ftb__messages"><div id="ftb-message-title" style="padding:12px 14px;border-bottom:1px solid #e0e4e8;font-size:12px;font-weight:800">Select a dispute</div><div id="ftb-messages-body" class="ftb__messages-body"><div class="ftb__empty">Choose a case to see messages.</div></div><form id="ftb-message-form" class="ftb__composer" hidden><input id="ftb-message-input" placeholder="Type a message…" maxlength="2000"><button class="ftb__primary" type="submit">Send</button></form></div></div></section>
      <section data-panel="notifications" hidden><div class="ftb__pagehead"><div><h1>Notifications</h1><p>Order, payment, shipment and support updates.</p></div><button id="ftb-mark-all-read" class="ftb__secondary">Mark all read</button></div><article class="ft-shopify-card ftb__card" style="padding:0"><div id="ftb-notifications"></div><div id="ftb-notifications-empty" class="ftb__empty" hidden>No notifications yet.</div></article></section>
      <section data-panel="account" hidden><div class="ftb__pagehead"><div><h1>Profile & addresses</h1><p>Identity, delivery and business profile for your buyer account.</p></div></div><form id="ftb-account-form" class="ft-shopify-card ftb__card ftb__form"><label>Full name<input name="full_name" autocomplete="name"></label><label>Phone number<input name="phone" inputmode="tel" autocomplete="tel"></label><label>Address line 1<input name="address_line1" autocomplete="address-line1"></label><label>Address line 2<input name="address_line2" autocomplete="address-line2"></label><label>City<input name="city" autocomplete="address-level2"></label><label>State<input name="state" autocomplete="address-level1"></label><label>Pincode<input name="pincode" inputmode="numeric" autocomplete="postal-code"></label><label>Buyer type<select name="buyer_type"><option value="end_user">Buy for me / end user</option><option value="retail_store">Retail store / business buyer</option></select></label><label>Business name<input name="business_name"></label><label>GSTIN<input name="gstin" maxlength="15" autocapitalize="characters"></label><div class="ftb__wide ftb__actions"><button class="ftb__primary" type="submit">Save profile</button></div></form></section>
    </div></main>
  </div>
</section>
