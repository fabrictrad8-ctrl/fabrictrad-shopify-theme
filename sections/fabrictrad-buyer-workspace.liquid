const $=id=>document.getElementById(id),money=n=>new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:2}).format(Number(n||0)),date=d=>d?new Intl.DateTimeFormat('en-IN',{dateStyle:'medium'}).format(new Date(d)):'—',dateTime=d=>d?new Intl.DateTimeFormat('en-IN',{dateStyle:'medium',timeStyle:'short'}).format(new Date(d)):'—';let sb,session,profile,buyerProfile,orders=[],catalogOrders=[],shipments=[],requirements=[],disputes=[],notifications=[],cart={items:[],item_count:0,total_price:0},activeDispute=null,orderFilter='all';
const meta={overview:['Your account','Orders and buying shortcuts'],orders:['Your orders','Payment, invoices and order status'],tracking:['Track packages','Shipment and delivery status'],cart:['Cart','Products to review before ordering'],requirements:['Sourcing requests','Post what you need'],disputes:['Messages & disputes','Seller and support conversations'],notifications:['Notifications','Email and in-app updates'],account:['Profile & addresses','Identity, delivery and business profile']};
function alertMsg(t,type='info'){const n=$('ftb-alert');n.textContent=t;n.dataset.type=type;n.hidden=!t}function pill(v){const s=document.createElement('span');s.className='ftb__pill';s.dataset.state=String(v||'').toLowerCase();s.textContent=String(v||'unknown').replaceAll('_',' ');return s}function el(tag,cls,text){const n=document.createElement(tag);if(cls)n.className=cls;if(text!==undefined)n.textContent=String(text);return n}function tab(name,push=true){document.querySelectorAll('[data-panel]').forEach(p=>p.hidden=p.dataset.panel!==name);document.querySelectorAll('[data-tab]').forEach(b=>b.classList.toggle('is-active',b.dataset.tab===name));$('ftb-active-title').textContent=meta[name]?.[0]||'Buyer';$('ftb-active-desc').textContent=meta[name]?.[1]||'';closeMenu();if(push){const u=new URL(location.href);if(name==='overview')u.searchParams.delete('tab');else u.searchParams.set('tab',name);history.replaceState({},'',u)}if(name==='disputes')renderDisputes()}
function openMenu(){$('ftb-sidebar').classList.add('is-open');$('ftb-overlay').hidden=false}function closeMenu(){$('ftb-sidebar').classList.remove('is-open');$('ftb-overlay').hidden=true}
async function loadAll(){const uid=session.user.id;const [bp,co,oo,sh,rq,ds,ns]=await Promise.all([sb.from('buyer_profiles').select('*').eq('user_id',uid).maybeSingle(),sb.from('catalog_order_requests').select('id,status,payment_status,total_amount,quantity,unit,created_at,seller_id,product_id,seller_products(name,sku)').eq('buyer_id',uid).order('created_at',{ascending:false}).limit(200),sb.from('orders').select('id,order_ref,status,total_amount,payment_status,fulfillment_status,shopify_order_name,commerce_source,created_at,updated_at,requires_review,review_status,seller_id,shipping_address').order('created_at',{ascending:false}).limit(200),sb.from('seller_shipments').select('id,order_id,status,courier_name,awb_number,tracking_url,estimated_delivery,updated_at,shipping_cost').eq('buyer_id',uid).order('updated_at',{ascending:false}).limit(200),sb.from('buyer_requirements').select('*').eq('buyer_id',uid).order('created_at',{ascending:false}).limit(200),sb.from('disputes').select('*').order('updated_at',{ascending:false}).limit(100),sb.from('commerce_notifications').select('*').eq('user_id',uid).order('created_at',{ascending:false}).limit(200)]);buyerProfile=bp.data||null;catalogOrders=co.data||[];orders=oo.data||[];shipments=sh.data||[];requirements=rq.data||[];disputes=ds.data||[];notifications=ns.data||[];try{const r=await fetch('/cart.js',{headers:{Accept:'application/json'}});cart=await r.json()}catch{cart={items:[],item_count:0,total_price:0}}renderAll()}
function combinedOrders(){const op=orders.map(o=>({id:o.id,ref:o.shopify_order_name||o.order_ref||('FT-'+o.id.slice(0,8).toUpperCase()),product:o.commerce_source==='shopify'?'Shopify marketplace order':'FabricTrad order',source:o.commerce_source||'fabrictrad',status:o.status||'pending',payment:o.payment_status||'unknown',fulfillment:o.fulfillment_status||'unfulfilled',total:Number(o.total_amount||0),created:o.created_at}));const cat=catalogOrders.map(o=>({id:o.id,ref:'FT-CAT-'+o.id.slice(0,8).toUpperCase(),product:o.seller_products?.name||'Catalogue product',source:'catalogue',status:o.status||'pending',payment:o.payment_status||'unpaid',fulfillment:'—',total:Number(o.total_amount||0),created:o.created_at}));return [...op,...cat].sort((a,b)=>new Date(b.created).getTime()-new Date(a.created).getTime())}
function renderAll(){const c=combinedOrders(),pending=c.filter(o=>['pending','draft','quote_sent','pending_seller_confirmation'].includes(String(o.status).toLowerCase())),paid=c.filter(o=>String(o.payment).toLowerCase()==='paid'),activeShip=shipments.filter(s=>!['delivered','cancelled','failed','rto_delivered'].includes(String(s.status||'').toLowerCase())),monthPaid=paid.filter(o=>{const d=new Date(o.created),n=new Date();return d.getMonth()===n.getMonth()&&d.getFullYear()===n.getFullYear()}).reduce((s,o)=>s+o.total,0);const h=new Date().getHours(),g=h<12?'Good morning':h<17?'Good afternoon':'Good evening';$('ftb-greeting').textContent=`${g}, ${profile.full_name||session.user.email?.split('@')[0]||'Buyer'}`;const tiles=[['▣','Your orders','Pay accepted orders, download documents and view order history.','orders'],['🚚','Track packages','See dispatch and delivery progress for active shipments.','tracking'],['🛒','Cart',cart.item_count?`${cart.item_count} item${cart.item_count===1?'':'s'} waiting for review.`:'Keep products together before checkout.','cart'],['◉','Sourcing requests','Tell verified sellers exactly what you need and your deadline.','requirements'],['●','Profile & addresses','Keep delivery, contact and business details current.','account'],['✉','Messages & disputes','Keep seller conversations and support cases in one place.','disputes']];const th=$('ftb-overview-tiles');th.replaceChildren();tiles.forEach(x=>{const b=el('button','ft-shopify-card ftb__tile');b.type='button';b.dataset.go=x[3];b.innerHTML=`<span class="ftb__tile-icon">${x[0]}</span><span><strong>${x[1]}</strong><span>${x[2]}</span></span>`;th.append(b)});const stats=[['Awaiting seller',pending.length],['Payment settled',paid.length],['Active shipments',activeShip.length],['Paid this month',money(monthPaid)]];const sh=$('ftb-stats');sh.replaceChildren();stats.forEach(x=>{const a=el('article','ft-shopify-card ftb__stat');a.innerHTML=`<span>${x[0]}</span><strong>${x[1]}</strong>`;sh.append(a)});renderOrders();renderRecent(c);renderShipments();renderCart();renderRequirements();renderNotifications();fillAccount();const count=Number(cart.item_count||0);['ftb-cart-count','ftb-nav-cart-count'].forEach(id=>{$(id).textContent=count;$(id).hidden=!count});const unread=notifications.filter(n=>!n.is_read).length;$('ftb-unread-count').textContent=unread;$('ftb-unread-count').hidden=!unread}
function filterMatch(o){const s=String(o.status).toLowerCase(),p=String(o.payment).toLowerCase(),f=String(o.fulfillment).toLowerCase();if(orderFilter==='all')return true;if(orderFilter==='pending')return ['pending','draft','quote_sent','pending_seller_confirmation','accepted','confirmed'].includes(s)&&p!=='paid';if(orderFilter==='paid')return p==='paid';if(orderFilter==='shipped')return s==='shipped'||f.includes('progress')||f.includes('fulfilled');if(orderFilter==='delivered')return s==='delivered'||f==='fulfilled';return ['cancelled','refunded'].includes(s)||p.includes('refund')}
function renderOrders(){const body=$('ftb-orders-body');body.replaceChildren();const list=combinedOrders().filter(filterMatch);list.forEach(o=>{const tr=document.createElement('tr');const c1=el('td');c1.innerHTML=`<strong>${o.ref}</strong><br><span>${o.source}</span>`;const c2=el('td');c2.innerHTML=`<strong>${o.product}</strong>`;const c3=el('td');c3.append(pill(o.status));const c4=el('td');c4.append(pill(o.payment));const c5=el('td','',money(o.total));const c6=el('td','',date(o.created));tr.append(c1,c2,c3,c4,c5,c6);body.append(tr)});$('ftb-orders-empty').hidden=!!list.length}
function renderRecent(c){const host=$('ftb-recent-orders');host.replaceChildren();c.slice(0,5).forEach(o=>{const r=el('div','ftb__row');const a=el('div');a.innerHTML=`<strong>${o.ref}</strong><br><span>${o.product}</span>`;const b=el('div');b.append(pill(o.status));r.append(a,b,el('strong','',money(o.total)),el('span','',date(o.created)));host.append(r)});if(!c.length)host.append(el('div','ftb__empty','No orders for this account yet.'))}
function renderShipments(){const active=$('ftb-active-shipments'),all=$('ftb-shipments');active.replaceChildren();all.replaceChildren();shipments.forEach((s,i)=>{const row=el('div','ftb__shipment');const icon=el('span','ftb__shipment-icon','🚚'),mid=el('div');mid.innerHTML=`<h3>${s.courier_name||'Shipment'} · ${s.awb_number||'AWB pending'}</h3><p>${String(s.status||'pending').replaceAll('_',' ')} · Updated ${dateTime(s.updated_at)}${s.estimated_delivery?' · ETA '+date(s.estimated_delivery):''}</p>`;const right=s.tracking_url?el('a','ftb__secondary','Track'):el('span','',String(s.status||'pending'));if(s.tracking_url){right.href=s.tracking_url;right.target='_blank';right.rel='noopener'}row.append(icon,mid,right);all.append(row);if(i<3&&!['delivered','cancelled','failed'].includes(String(s.status||'').toLowerCase()))active.append(row.cloneNode(true))});$('ftb-shipments-empty').hidden=!!shipments.length;if(!active.childElementCount)active.append(el('div','ftb__empty','No active shipments.'))}
function renderCart(){const host=$('ftb-cart-list');host.replaceChildren();(cart.items||[]).forEach(i=>{const r=el('div','ftb__row');const a=el('div');a.innerHTML=`<strong>${i.product_title||i.title}</strong><br><span>${i.variant_title||''}</span>`;r.append(a,el('span','',`Qty ${i.quantity}`),el('strong','',money(Number(i.final_line_price||0)/100)),el('span','',i.vendor||'FabricTrad seller'));host.append(r)});$('ftb-cart-empty').hidden=!!(cart.items||[]).length}
function renderRequirements(){const host=$('ftb-requirements');host.replaceChildren();requirements.forEach(r=>{const a=el('article','ftb__requirement');a.innerHTML=`<div style="display:flex;justify-content:space-between;gap:10px"><div><h3>${r.title}</h3><p>${r.description||''}</p><p>${[r.category,r.quantity,r.budget,r.deadline?('Due '+date(r.deadline)):null].filter(Boolean).join(' · ')}</p></div></div>`;a.append(pill(r.status||'open'));host.append(a)});$('ftb-requirements-empty').hidden=!!requirements.length}
function renderNotifications(){const host=$('ftb-notifications');host.replaceChildren();notifications.forEach(n=>{const r=el('article','ftb__notification'+(!n.is_read?' unread':''));const a=el('div');a.innerHTML=`<h3>${n.title||'FabricTrad update'}</h3><p>${n.message||''}</p><p>${dateTime(n.created_at)}</p>`;const b=el('button','',n.is_read?'Read':'Mark read');b.type='button';b.disabled=!!n.is_read;b.onclick=()=>markRead(n.id);r.append(a,b);host.append(r)});$('ftb-notifications-empty').hidden=!!notifications.length}
function fillAccount(){const f=$('ftb-account-form');['full_name','phone','address_line1','address_line2','city','state','pincode'].forEach(k=>{if(f.elements[k])f.elements[k].value=profile[k]||''});f.elements.buyer_type.value=buyerProfile?.buyer_type||'end_user';f.elements.business_name.value=buyerProfile?.business_name||profile.business_name||'';f.elements.gstin.value=buyerProfile?.gstin||profile.gstin||''}
async function renderDisputes(){const list=$('ftb-dispute-list');list.replaceChildren();disputes.forEach(d=>{const b=el('button','ftb__thread'+(activeDispute?.id===d.id?' is-active':''));b.type='button';b.innerHTML=`<strong>${d.product_name||d.dispute_type||'Support case'}</strong><span>${String(d.status||'open').replaceAll('_',' ')} · ${date(d.updated_at||d.created_at)}</span>`;b.onclick=()=>openDispute(d);list.append(b)});if(!disputes.length)list.append(el('div','ftb__empty','No open or previous disputes.'))}
async function openDispute(d){activeDispute=d;renderDisputes();$('ftb-message-title').textContent=(d.product_name||d.dispute_type||'Support case')+' · '+String(d.status||'open').replaceAll('_',' ');const {data,error}=await sb.from('dispute_messages').select('*').eq('dispute_id',d.id).order('created_at',{ascending:true});const host=$('ftb-messages-body');host.replaceChildren();if(error){host.append(el('div','ftb__empty',error.message));return}(data||[]).forEach(m=>{const b=el('div','ftb__bubble'+(m.sender_id===session.user.id?' mine':''));b.textContent=m.message_text;host.append(b)});$('ftb-message-form').hidden=!['open','under_review','escalated'].includes(String(d.status));host.scrollTop=host.scrollHeight}
async function markRead(id){await sb.from('commerce_notifications').update({is_read:true,read_at:new Date().toISOString()}).eq('id',id);await refreshNotifications()}
async function refreshNotifications(){const {data}=await sb.from('commerce_notifications').select('*').eq('user_id',session.user.id).order('created_at',{ascending:false}).limit(200);notifications=data||[];renderNotifications();const unread=notifications.filter(n=>!n.is_read).length;$('ftb-unread-count').textContent=unread;$('ftb-unread-count').hidden=!unread}
function wire(){document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>tab(b.dataset.tab));document.addEventListener('click',e=>{const b=e.target.closest('[data-go]');if(b)tab(b.dataset.go)});$('ftb-menu').onclick=openMenu;$('ftb-overlay').onclick=closeMenu;$('ftb-search').onsubmit=e=>{e.preventDefault();const q=$('ftb-search-input').value.trim();location.href=q?'/search?q='+encodeURIComponent(q):'/collections/fabrictrad-catalogue'};$('ftb-notification-button').onclick=()=>tab('notifications');$('ftb-profile-button').onclick=()=>tab('account');$('ftb-signout').onclick=async()=>{await sb.auth.signOut();location.replace('/pages/login?role=buyer')};$('ftb-refresh-orders').onclick=async()=>{alertMsg('Refreshing orders…');await loadAll();alertMsg('Orders refreshed.','success')};document.querySelectorAll('[data-order-filter]').forEach(b=>b.onclick=()=>{orderFilter=b.dataset.orderFilter;document.querySelectorAll('[data-order-filter]').forEach(x=>x.classList.toggle('is-active',x===b));renderOrders()});$('ftb-toggle-requirement').onclick=()=>{$('ftb-requirement-form').hidden=false};$('ftb-cancel-requirement').onclick=()=>{$('ftb-requirement-form').hidden=true};$('ftb-requirement-form').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.currentTarget),payload={buyer_id:session.user.id,title:String(f.get('title')||'').trim(),description:String(f.get('description')||'').trim(),category:String(f.get('category')||'').trim()||null,quantity:String(f.get('quantity')||'').trim()||null,budget:String(f.get('budget')||'').trim()||null,deadline:String(f.get('deadline')||'').trim()||null,status:'open'};const {error}=await sb.from('buyer_requirements').insert(payload);if(error){alertMsg(error.message,'error');return}e.currentTarget.reset();e.currentTarget.hidden=true;alertMsg('Sourcing request posted.','success');await loadAll()};$('ftb-message-form').onsubmit=async e=>{e.preventDefault();if(!activeDispute)return;const text=$('ftb-message-input').value.trim();if(!text)return;const {error}=await sb.from('dispute_messages').insert({dispute_id:activeDispute.id,sender_type:'buyer',sender_id:session.user.id,sender_name:profile.full_name||session.user.email||'Buyer',message_text:text});if(error){alertMsg(error.message,'error');return}$('ftb-message-input').value='';await openDispute(activeDispute)};$('ftb-mark-all-read').onclick=async()=>{await sb.from('commerce_notifications').update({is_read:true,read_at:new Date().toISOString()}).eq('user_id',session.user.id).eq('is_read',false);await refreshNotifications()};$('ftb-account-form').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.currentTarget),u={full_name:String(f.get('full_name')||'').trim()||null,phone:String(f.get('phone')||'').trim()||null,address_line1:String(f.get('address_line1')||'').trim()||null,address_line2:String(f.get('address_line2')||'').trim()||null,city:String(f.get('city')||'').trim()||null,state:String(f.get('state')||'').trim()||null,pincode:String(f.get('pincode')||'').trim()||null,business_name:String(f.get('business_name')||'').trim()||null,gstin:String(f.get('gstin')||'').trim().toUpperCase()||null};const b={buyer_type:String(f.get('buyer_type')||'end_user'),business_name:u.business_name,gstin:u.gstin};const a=await sb.from('user_profiles').update(u).eq('id',session.user.id);if(a.error){alertMsg(a.error.message,'error');return}if(buyerProfile){const x=await sb.from('buyer_profiles').update(b).eq('user_id',session.user.id);if(x.error){alertMsg(x.error.message,'error');return}}profile={...profile,...u};buyerProfile={...(buyerProfile||{}),...b};alertMsg('Buyer profile saved.','success')}}
async function boot(){if(!window.FabricTradAuth){setTimeout(boot,60);return}wire();profile=await window.FabricTradAuth.guard('buyer');if(!profile)return;sb=await window.FabricTradAuth.getClient();const {data:{session:s}}=await sb.auth.getSession();session=s;if(!session)return;await loadAll();$('ftb-loading').hidden=true;document.querySelector('[data-ft-buyer-workspace]').hidden=false;const q=new URLSearchParams(location.search).get('tab');tab(meta[q]?q:'overview',false)}boot().catch(e=>{const l=$('ftb-loading');l.innerHTML='<div style="padding:30px;text-align:center;color:#991b1b">'+String(e.message||'Buyer workspace could not load.')+'</div>'});
})();
