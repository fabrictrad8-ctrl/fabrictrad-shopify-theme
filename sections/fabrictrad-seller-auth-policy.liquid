<style id="ftsp-role-cloak">html{visibility:hidden!important}</style>
<script>
(function(){
 const VERSION='20260828-primary-role-v1',URL='https://rdhfwlzhcvwjhkxhhpoo.supabase.co',KEY='sb_publishable_Un2-RQfjGbIiXF3Mb2oGIA_p-Z1kMls',SELLER='/pages/seller-portal',ADMIN='/pages/fabrictrad-admin';
 const SOURCES=['https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.110.0','https://unpkg.com/@supabase/supabase-js@2.110.0'];let clientPromise=null,checking=false;
 function timeout(p,ms,m){return Promise.race([Promise.resolve(p),new Promise((_,r)=>setTimeout(()=>r(new Error(m)),ms))])}function reveal(){document.getElementById('ftsp-role-cloak')?.remove();document.documentElement.style.visibility=''}function isAdmin(r){return r==='super_admin'||r==='admin_staff'}
 function notice(text,type='error'){const e=document.getElementById('ftsp-auth-notice');if(!e)return;e.textContent=text;e.hidden=false;e.dataset.type=type;e.setAttribute('role','alert')}
 function stripLinks(){document.querySelectorAll('.ftsp__top-actions a[href="/account"],.ftsp__store-link,a[href="/account"]').forEach(e=>{const t=(e.textContent||'').trim().toLowerCase();if(t.includes('buyer')||t.includes('marketplace')||e.classList.contains('ftsp__store-link'))e.remove()})}
 function observeLinks(){stripLinks();const o=new MutationObserver(stripLinks);o.observe(document.documentElement,{subtree:true,childList:true});setTimeout(()=>o.disconnect(),30000)}
 async function load(){if(window.FabricTradAuth?.getClient||window.supabase?.createClient)return;if(window.__fabrictradSupabaseLoader)return window.__fabrictradSupabaseLoader;window.__fabrictradSupabaseLoader=(async()=>{let last=null;for(const src of SOURCES){try{await timeout(new Promise((ok,bad)=>{const s=document.createElement('script');s.src=src;s.async=true;s.crossOrigin='anonymous';s.onload=()=>window.supabase?.createClient?ok():bad(new Error('Secure sign-in library loaded incorrectly.'));s.onerror=()=>bad(new Error('Unable to load secure sign-in library.'));document.head.appendChild(s)}),7000,'Seller sign-in library timed out.');if(window.supabase?.createClient)return}catch(e){last=e}}throw last||new Error('Unable to load Seller sign-in.')})();return window.__fabrictradSupabaseLoader}
 async function client(){if(window.FabricTradAuth?.getClient)return window.FabricTradAuth.getClient();if(!clientPromise)clientPromise=load().then(()=>window.supabase.createClient(URL,KEY,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}}));return clientPromise}
 async function profile(c,s,repair=false){let r=await timeout(c.from('user_profiles').select('role,is_active,can_buy,can_sell').eq('id',s.user.id).maybeSingle(),8000,'Seller profile lookup timed out.');if(r.error)throw r.error;if(r.data)return r.data;const meta=s.user?.user_metadata?.role||s.user?.app_metadata?.role||null;if(meta==='buyer')return{role:'buyer',is_active:true,can_buy:true,can_sell:false};if(isAdmin(meta))return{role:meta,is_active:true,can_buy:false,can_sell:false};if(!repair)return null;const e=await timeout(c.rpc('ensure_current_account_profile',{p_requested_role:'seller'}),8000,'Seller account setup timed out.');if(e.error)throw e.error;r=await timeout(c.from('user_profiles').select('role,is_active,can_buy,can_sell').eq('id',s.user.id).maybeSingle(),8000,'Seller profile lookup timed out.');if(r.error)throw r.error;return r.data||null}
 async function enforce(c,s,repair=false){if(!s){reveal();return false}const p=await profile(c,s,repair),role=p?.role||s.user?.user_metadata?.role||s.user?.app_metadata?.role||null;if(isAdmin(role)){await c.auth.signOut().catch(()=>{});location.replace(ADMIN);return false}if(role!=='seller'||!p||p.is_active!==true||p.can_sell===false){await c.auth.signOut().catch(()=>{});reveal();setTimeout(()=>notice(role==='buyer'?'This is a Buyer account. Seller Centre requires a separate Seller account. To use a different account type, sign out first.':'Seller Centre requires an active Seller account. Sign in with Seller credentials or create a separate Seller account.'),0);return false}stripLinks();reveal();return true}
 async function login(form){if(checking)return;checking=true;const c=await client(),email=(form.querySelector('input[type="email"]')?.value||'').trim().toLowerCase(),password=form.querySelector('input[type="password"]')?.value||'';if(!email||!password){checking=false;return}notice('Signing in to Seller Centre…','info');try{const{data,error}=await timeout(c.auth.signInWithPassword({email,password}),10000,'Seller sign-in timed out.');if(error)throw error;if(await enforce(c,data.session,true))location.replace(SELLER+'?ftv='+encodeURIComponent(VERSION))}catch(e){reveal();notice(e?.message||'Seller sign-in failed.')}finally{checking=false}}
 async function signup(form){if(checking)return;checking=true;const c=await client(),email=(form.querySelector('input[type="email"]')?.value||'').trim().toLowerCase(),password=form.querySelector('input[type="password"]')?.value||'';if(!email||!password){checking=false;return}notice('Creating separate Seller account…','info');try{const{data,error}=await timeout(c.auth.signUp({email,password,options:{data:{role:'seller'},emailRedirectTo:location.origin+SELLER}}),12000,'Seller account creation timed out.');if(error)throw error;if(!data.session){reveal();notice('Seller account created. Confirm the Seller email, then return to Seller Centre to sign in.','success');return}if(await enforce(c,data.session,true))location.replace(SELLER+'?ftv='+encodeURIComponent(VERSION))}catch(e){reveal();notice(e?.message||'Seller account creation failed. Buyer and Seller identities must remain separate.')}finally{checking=false}}
 document.addEventListener('submit',e=>{const f=e.target;if(!(f instanceof HTMLFormElement))return;if(f.id==='ftsp-login-form'){e.preventDefault();e.stopImmediatePropagation();void login(f)}else if(f.id==='ftsp-signup-form'){e.preventDefault();e.stopImmediatePropagation();void signup(f)}},true);
 window.addEventListener('pageshow',e=>{if(e.persisted)location.reload()});document.addEventListener('DOMContentLoaded',async()=>{observeLinks();try{const c=await client(),r=await timeout(c.auth.getSession(),8000,'Seller session lookup timed out.'),s=r?.data?.session||null;const ok=await enforce(c,s,false);if(!s)reveal();else if(ok)stripLinks()}catch(e){console.error('Seller role guard failed',e);reveal();setTimeout(()=>notice('Seller account verification could not complete. Please sign in again.'),0)}},{once:true});setTimeout(()=>{if(document.getElementById('ftsp-role-cloak')){reveal();notice('Seller account verification timed out. Please sign in again.')}},18000)
})();
</script>
