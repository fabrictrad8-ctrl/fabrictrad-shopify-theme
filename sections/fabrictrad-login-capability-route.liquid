<div data-ft-login-capability-route hidden></div>
<script>
(function(){
 function safeBuyerNext(){const q=new URLSearchParams(location.search),n=q.get('next')||'';if(!n.startsWith('/')||n.startsWith('//'))return '/pages/buyer-dashboard';if(n.startsWith('/pages/seller-portal')||n.startsWith('/pages/fabrictrad-admin')||n.startsWith('/pages/login'))return '/pages/buyer-dashboard';return n}
 function show(text,type='info'){const box=document.getElementById('ft-login-message');if(!box)return;box.textContent=text;box.dataset.type=type;box.hidden=!text}
 async function profileOrProvision(target){const sb=await window.FabricTradAuth.getClient();let p=await window.FabricTradAuth.getProfile(true);if(!p){const ensured=await sb.rpc('ensure_current_account_profile',{p_requested_role:target==='seller'?'seller':'buyer'});if(ensured.error)throw ensured.error;p=await window.FabricTradAuth.getProfile(true)}if(!p||p.is_active!==true){await sb.auth.signOut().catch(()=>{});throw new Error('This FabricTrad account is not active.')}return p}
 async function preRouteExistingSession(){try{if(!window.FabricTradAuth)return;const requested=new URLSearchParams(location.search).get('role');if(!['buyer','seller'].includes(requested))return;const sb=await window.FabricTradAuth.getClient(),session=await window.FabricTradAuth.getSession();if(!session)return;const p=await window.FabricTradAuth.getProfile(true);if(!p||p.is_active!==true){await sb.auth.signOut().catch(()=>{});show('This FabricTrad account is not active.','error');return}if(p.role==='super_admin'||p.role==='admin_staff'){location.replace('/pages/fabrictrad-admin');return}if(requested==='seller'){if(p.can_sell===true){location.replace('/pages/seller-portal');return}if(p.can_buy===true){location.replace('/pages/buyer-dashboard?status=buyer_only');return}show('Seller access is not enabled for this account.','error');return}if(p.can_buy===true){location.replace(safeBuyerNext());return}show('Buyer access is not enabled for this account.','error')}catch(e){console.warn('Existing FabricTrad session routing skipped',e);show(e.message||'Unable to verify this account.','error')}}
 function updateCopy(){const visual=document.querySelector('.ft-auth-visual');if(!visual)return;visual.querySelectorAll('p').forEach(p=>{const t=(p.textContent||'').trim();if(t.includes('Buyers enter the private marketplace. Sellers enter seller operations.'))p.textContent='Buyer-only accounts stay in the private buyer marketplace. Seller Centre opens only for accounts with verified seller access.'});visual.querySelectorAll('.ft-auth-flow-card span').forEach(s=>{const t=(s.textContent||'').trim();if(t==='We verify your buyer or seller role')s.textContent='We verify your active account permissions';if(t==='Open only the workspace meant for you')s.textContent='Open only the workspace your account can use'})}
 document.addEventListener('submit',async function(e){
   const form=e.target;if(!form||form.id!=='ft-password-login')return;e.preventDefault();e.stopImmediatePropagation();
   const email=document.getElementById('ft-login-email')?.value.trim().toLowerCase()||'',password=document.getElementById('ft-login-password')?.value||'',target=document.querySelector('[data-role].is-active')?.dataset.role||new URLSearchParams(location.search).get('role')||'buyer';if(!email||!password){show('Enter your email and password.','error');return}show('Signing in…');
   try{if(!window.FabricTradAuth)throw new Error('FabricTrad sign-in is still loading. Please retry.');const sb=await window.FabricTradAuth.getClient();const signed=await sb.auth.signInWithPassword({email,password});if(signed.error)throw signed.error;const p=await profileOrProvision(target);if(p.role==='super_admin'||p.role==='admin_staff'){await sb.auth.signOut();location.replace('/pages/login?role=admin');return}if(target==='seller'){if(p.can_sell!==true){await sb.auth.signOut().catch(()=>{});throw new Error('This FabricTrad account is buyer-only. Use Buyer sign in.')}location.replace('/pages/seller-portal');return}if(p.can_buy!==true){await sb.auth.signOut().catch(()=>{});throw new Error('Buyer access is not enabled for this account.')}location.replace(safeBuyerNext())}catch(err){show(err.message||'Sign in failed.','error')}
 },true);
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>{updateCopy();preRouteExistingSession()},{once:true});else{updateCopy();preRouteExistingSession()}
})();
</script>
