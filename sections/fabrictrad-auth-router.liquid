{% assign ft_scope = 'private' %}
{% if request.page_type == 'index' %}
  {% assign ft_scope = 'landing' %}
{% elsif request.page_type == 'page' %}
  {% if page.handle == 'login' or page.template_suffix == 'fabrictrad-login' %}
    {% assign ft_scope = 'login' %}
  {% elsif page.handle == 'buyer-dashboard' or page.template_suffix == 'fabrictrad-buyer' %}
    {% assign ft_scope = 'buyer' %}
  {% elsif page.handle == 'seller-portal' %}
    {% assign ft_scope = 'seller' %}
  {% elsif page.handle == 'fabrictrad-admin' %}
    {% assign ft_scope = 'admin' %}
  {% endif %}
{% endif %}

{% if ft_scope == 'landing' or ft_scope == 'login' %}
<style>
html.ft-entry-mode .shopify-section-group-header-group,
html.ft-entry-mode .shopify-section-group-footer-group,
html.ft-entry-mode #shopify-section-header,
html.ft-entry-mode #shopify-section-footer,
html.ft-entry-mode .announcement-bar-section,
html.ft-entry-mode cart-drawer,
html.ft-entry-mode search-modal,
html.ft-entry-mode predictive-search{display:none!important}
html.ft-entry-mode #MainContent{margin:0!important;padding:0!important;max-width:none!important}
</style>
{% else %}
<style id="ft-auth-cloak">html.ft-auth-pending body{visibility:hidden!important}</style>
{% endif %}

<script>
(function(){
  const VERSION='2026-08-28-auth-v10-stable';
  if(window.FabricTradAuth?.version===VERSION)return;

  const SCOPE={{ ft_scope | json }};
  const URL='https://rdhfwlzhcvwjhkxhhpoo.supabase.co';
  const KEY='sb_publishable_Un2-RQfjGbIiXF3Mb2oGIA_p-Z1kMls';
  const SDK_SOURCES=[
    'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.110.0',
    'https://unpkg.com/@supabase/supabase-js@2.110.0'
  ];
  const PATHS={
    login:'/pages/login',
    buyer:'/collections/fabrictrad-catalogue',
    buyerDashboard:'/pages/buyer-dashboard',
    seller:'/pages/seller-portal',
    admin:'/pages/fabrictrad-admin'
  };

  if(SCOPE==='landing'||SCOPE==='login')document.documentElement.classList.add('ft-entry-mode');
  else document.documentElement.classList.add('ft-auth-pending');

  let clientPromise=null;
  let profilePromise=null;
  const guardPromises=new Map();

  function withTimeout(promise,ms,message){
    return Promise.race([
      Promise.resolve(promise),
      new Promise((_,reject)=>setTimeout(()=>reject(new Error(message)),ms))
    ]);
  }
  function safeNext(){
    const value=location.pathname+location.search;
    return value.startsWith('/')&&!value.startsWith('//')?value:'/';
  }
  function roleHint(scope){
    return scope==='seller'?'seller':scope==='admin'?'admin':'buyer';
  }
  function loginUrl(scope='buyer',status=''){
    const q=new URLSearchParams({role:roleHint(scope),next:safeNext()});
    if(status)q.set('status',status);
    return PATHS.login+'?'+q.toString();
  }
  function release(){
    document.documentElement.classList.remove('ft-auth-pending');
    const cloak=document.getElementById('ft-auth-cloak');
    if(cloak)cloak.remove();
    document.documentElement.style.visibility='';
  }
  function sellerOnboardingRequested(){
    return new URLSearchParams(location.search).get('onboarding')==='1';
  }

  async function loadLibrary(){
    if(window.supabase?.createClient)return;
    if(window.__fabrictradSupabaseLoader)return window.__fabrictradSupabaseLoader;
    window.__fabrictradSupabaseLoader=(async()=>{
      let lastError=null;
      for(const src of SDK_SOURCES){
        try{
          await withTimeout(new Promise((resolve,reject)=>{
            const script=document.createElement('script');
            script.src=src;
            script.async=true;
            script.crossOrigin='anonymous';
            script.onload=()=>window.supabase?.createClient
              ?resolve()
              :reject(new Error('Supabase library loaded without createClient.'));
            script.onerror=()=>reject(new Error('Unable to load secure sign-in library.'));
            document.head.appendChild(script);
          }),7000,'Secure sign-in library timed out.');
          if(window.supabase?.createClient)return;
        }catch(error){
          lastError=error;
          console.warn('FabricTrad auth source failed',src,error);
        }
      }
      throw lastError||new Error('Unable to load FabricTrad sign-in.');
    })();
    return window.__fabrictradSupabaseLoader;
  }

  async function getClient(){
    if(!clientPromise){
      clientPromise=loadLibrary().then(()=>window.supabase.createClient(URL,KEY,{
        auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}
      }));
    }
    return clientPromise;
  }

  async function getSession(){
    const sb=await getClient();
    const result=await withTimeout(sb.auth.getSession(),8000,'Session lookup timed out.');
    if(result?.error)throw result.error;
    return result?.data?.session||null;
  }

  async function getProfile(force=false){
    if(force)profilePromise=null;
    if(profilePromise)return profilePromise;
    profilePromise=(async()=>{
      const session=await getSession();
      if(!session)return null;
      const sb=await getClient();
      const fields='id,email,full_name,phone,role,is_active,can_buy,can_sell,address_line1,address_line2,city,state,pincode,business_name,gstin,account_kind,verification_status';
      const result=await withTimeout(
        sb.from('user_profiles').select(fields).eq('id',session.user.id).maybeSingle(),
        8000,
        'Profile lookup timed out.'
      );
      if(result.error)throw result.error;
      return result.data||null;
    })();
    return profilePromise;
  }

  const isAdmin=profile=>!!profile&&(profile.role==='super_admin'||profile.role==='admin_staff');

  function homeFor(profile,preferred=''){
    if(!profile||profile.is_active!==true)return null;
    if(isAdmin(profile))return PATHS.admin;
    if(preferred==='seller'&&profile.can_sell===true)return PATHS.seller;
    if(preferred==='buyer'&&profile.can_buy===true)return PATHS.buyerDashboard;
    if(profile.can_buy===true)return PATHS.buyerDashboard;
    if(profile.can_sell===true)return PATHS.seller;
    return null;
  }

  async function signOutAndLogin(scope,status){
    try{
      const sb=await getClient();
      await withTimeout(sb.auth.signOut(),5000,'Sign out timed out.');
    }catch(_){}
    location.replace(loginUrl(scope,status));
    return null;
  }

  async function guardImpl(scope){
    const session=await getSession();
    if(!session){
      location.replace(loginUrl(scope));
      return null;
    }

    const profile=await getProfile(true);
    if(!profile||profile.is_active!==true)return signOutAndLogin(scope,'inactive');

    if(scope==='admin'){
      if(!isAdmin(profile)){
        location.replace(homeFor(profile)||PATHS.login);
        return null;
      }
      release();
      return profile;
    }

    if(isAdmin(profile)){
      location.replace(PATHS.admin);
      return null;
    }

    if(scope==='seller'){
      if(profile.can_sell===true){
        release();
        return profile;
      }
      if(profile.can_buy===true&&sellerOnboardingRequested()){
        release();
        return profile;
      }
      if(profile.can_buy===true){
        location.replace(PATHS.buyerDashboard+'?status=buyer_only');
        return null;
      }
      return signOutAndLogin(scope,'access');
    }

    if(scope==='buyer'||scope==='private'){
      if(profile.can_buy===true){
        release();
        return profile;
      }
      if(profile.can_sell===true){
        location.replace(PATHS.seller);
        return null;
      }
      return signOutAndLogin(scope,'access');
    }

    release();
    return profile;
  }

  function guard(scope=SCOPE){
    if(guardPromises.has(scope))return guardPromises.get(scope);
    const promise=guardImpl(scope).catch(error=>{
      guardPromises.delete(scope);
      throw error;
    });
    guardPromises.set(scope,promise);
    return promise;
  }

  async function routeLanding(){
    try{
      const session=await getSession();
      if(!session)return null;
      const profile=await getProfile(true);
      if(!profile||profile.is_active!==true){
        try{const sb=await getClient();await sb.auth.signOut();}catch(_){}
        return null;
      }
      const destination=homeFor(profile);
      if(destination)location.replace(destination);
      return profile;
    }catch(error){
      console.warn('FabricTrad landing session check skipped',error);
      return null;
    }
  }

  function installLoginHints(){
    const q=new URLSearchParams(location.search);
    const status=q.get('status');
    const signup=q.get('signup')==='1';
    const statusText=
      status==='inactive'?'This FabricTrad account is not active yet. Please use an active account or contact FabricTrad support.':
      status==='buyer_only'?'This account does not currently have Seller Centre access.':
      status==='access'?'This active account does not currently have permission for that area.':
      status==='service'?'We could not verify your account session. Please sign in again.':'';
    let tries=0;
    const timer=setInterval(()=>{
      tries++;
      if(signup){
        const button=document.getElementById('ft-show-signup');
        if(button)button.click();
      }
      if(statusText){
        const box=document.getElementById('ft-login-message');
        if(box){
          box.textContent=statusText;
          box.dataset.type='error';
          box.hidden=false;
        }
      }
      if(tries>80||((!signup||document.getElementById('ft-signup')?.hidden===false)&&(!statusText||document.getElementById('ft-login-message')))){
        clearInterval(timer);
      }
    },75);
  }

  window.FabricTradAuth={
    version:VERSION,
    getClient,
    getSession,
    getProfile,
    guard,
    homeFor,
    loginUrl,
    paths:PATHS,
    withTimeout,
    refreshProfile:()=>getProfile(true),
    ready:null
  };

  if(SCOPE==='landing'){
    window.FabricTradAuth.ready=routeLanding();
  }else if(SCOPE==='login'){
    installLoginHints();
    window.FabricTradAuth.ready=Promise.resolve(null);
  }else{
    window.FabricTradAuth.ready=guard(SCOPE).catch(error=>{
      console.error('FabricTrad auth guard failed',error);
      release();
      location.replace(loginUrl(SCOPE,'service'));
      return null;
    });
  }

  if(SCOPE!=='landing'&&SCOPE!=='login'){
    setTimeout(()=>{
      if(document.documentElement.classList.contains('ft-auth-pending')){
        console.error('FabricTrad auth safety timeout');
        release();
        location.replace(loginUrl(SCOPE,'service'));
      }
    },18000);
  }
})();
</script>
{% schema %}{"name":"FabricTrad auth","tag":"section","class":"fabrictrad-auth-router","settings":[],"presets":[{"name":"FabricTrad auth"}]}{% endschema %}
