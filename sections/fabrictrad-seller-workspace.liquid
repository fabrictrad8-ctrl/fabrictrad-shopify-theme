async function uploadProductMedia(productId,files){const urls=[];for(const file of files){if(file.size>(file.type.startsWith('video/')?50:10)*1024*1024)throw new Error(`${file.name} is too large.`);const safe=file.name.replace(/[^a-zA-Z0-9._-]+/g,'-').slice(-100),path=`${session.user.id}/${seller.id}/${productId}/${Date.now()}-${safe}`;const up=await sb.storage.from('seller-product-media').upload(path,file,{contentType:file.type,upsert:false});if(up.error)throw up.error;const pub=sb.storage.from('seller-product-media').getPublicUrl(path).data.publicUrl;urls.push(pub);const mediaType=file.type.startsWith('video/')?'video':'image';const ins=await sb.from('seller_product_media').insert({product_id:productId,seller_id:seller.id,media_type:mediaType,view_type:'general',public_url:pub,storage_path:path,original_filename:file.name,mime_type:file.type,file_size:file.size,sort_order:urls.length-1});if(ins.error)throw ins.error}if(urls.length)await sb.from('seller_products').update({image_url:urls.find(u=>true),image_urls:urls}).eq('id',productId)}
function wire(){document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>tab(b.dataset.tab));document.addEventListener('click',e=>{const b=e.target.closest('[data-go]');if(b)tab(b.dataset.go)});$('fts-menu').onclick=openMenu;$('fts-overlay').onclick=closeMenu;$('fts-signout').onclick=async()=>{await sb.auth.signOut();location.replace('/pages/login?role=seller')};$('fts-search').onsubmit=e=>{e.preventDefault();const q=$('fts-search-input').value.toLowerCase().trim();if(!q)return;const hit=Object.keys(meta).find(k=>(k+' '+meta[k].join(' ')).toLowerCase().includes(q));if(hit)tab(hit);$('fts-search-input').value=''};$('fts-refresh').onclick=async()=>{alertMsg('Refreshing seller data…');await load();alertMsg('Seller workspace refreshed.','success')};$('fts-ai-analyze').onclick=async()=>{const text=$('fts-ai-text').value.trim();if(!text){alertMsg('Describe the product first.','error');return}alertMsg('Organising product details with AI…');const {data:{session:s}}=await sb.auth.getSession();const r=await fetch('https://rdhfwlzhcvwjhkxhhpoo.supabase.co/functions/v1/seller-catalog-assistant',{method:'POST',headers:{Authorization:`Bearer ${s.access_token}`,apikey:'sb_publishable_Un2-RQfjGbIiXF3Mb2oGIA_p-Z1kMls','Content-Type':'application/json'},body:JSON.stringify({text})});const p=await r.json();if(!r.ok){alertMsg(p.error||'Catalogue assistant failed.','error');return}const f=$('fts-product-form'),d=p.draft||{};[['name','name'],['description','description'],['fabric_name','fabricName'],['category','category'],['quality','quality'],['product_type','productType'],['price_per_unit','pricePerUnit'],['unit_label','unitLabel'],['available_quantity','availableQuantity'],['moq','moq'],['width_inches','widthInches'],['gsm','gsm'],['work_type','workType'],['sale_channel','saleChannel']].forEach(([n,k])=>{if(d[k]!==null&&d[k]!==undefined&&d[k]!==''&&f.elements[n])f.elements[n].value=d[k]});alertMsg('Product fields organised. Review them before submission.','success')};$('fts-product-media').onchange=e=>{const h=$('fts-media-preview');h.replaceChildren();Array.from(e.target.files||[]).slice(0,24).forEach(file=>{const box=el('div','fts__media-item'),url=URL.createObjectURL(file),m=file.type.startsWith('video/')?document.createElement('video'):document.createElement('img');m.src=url;if(m.tagName==='VIDEO'){m.muted=true;m.controls=true}box.append(m);h.append(box)})};$('fts-product-reset').onclick=()=>{$('fts-product-form').reset();$('fts-media-preview').replaceChildren()};$('fts-product-form').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.currentTarget),unitLabel=clean(f.get('unit_label'))||'metre',payload={seller_id:seller.id,name:clean(f.get('name')),sku:clean(f.get('sku')),fabric_name:clean(f.get('fabric_name'))||null,category:clean(f.get('category'))||'Other',quality:clean(f.get('quality'))||null,product_type:clean(f.get('product_type'))||'Fabric Only',description:clean(f.get('description'))||null,price_per_unit:Number(f.get('price_per_unit')),unit:unitCode(unitLabel),unit_label:unitLabel,available_quantity:Number(f.get('available_quantity')||0),moq:Number(f.get('moq')||1),width_inches:clean(f.get('width_inches'))?Number(f.get('width_inches')):null,gsm:clean(f.get('gsm'))?Number(f.get('gsm')):null,work_type:clean(f.get('work_type'))||null,sale_channel:clean(f.get('sale_channel'))||'both',gtin:clean(f.get('gtin'))||null,hsn_code:clean(f.get('hsn_code'))||null,status:'draft',approval_status:'pending',source:'manual'};alertMsg('Saving product…');const r=await sb.from('seller_products').insert(payload).select('id').single();if(r.error){alertMsg(r.error.message,'error');return}try{const files=Array.from($('fts-product-media').files||[]).slice(0,24);if(files.length)await uploadProductMedia(r.data.id,files);const submit=await sb.rpc('submit_my_seller_product_for_review',{p_product_id:r.data.id});if(submit.error)throw submit.error;e.currentTarget.reset();$('fts-media-preview').replaceChildren();alertMsg('Listing submitted for FabricTrad approval.','success');await load();tab('inventory')}catch(err){alertMsg(err.message||'Product saved but media/review submission needs attention.','error');await load()}};$('fts-toggle-variant').onclick=()=>{$('fts-variant-form').hidden=false};$('fts-cancel-variant').onclick=()=>{$('fts-variant-form').hidden=true};$('fts-variant-form').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.currentTarget),pid=clean(f.get('product_id')),p=products.find(x=>x.id===pid);if(!p)return;const color=clean(f.get('color_name')),code=clean(f.get('variant_code'))||`${p.sku}-${color.replace(/[^a-z0-9]/gi,'').toUpperCase().slice(0,12)}`;const r=await sb.from('seller_product_variants').insert({product_id:pid,seller_id:seller.id,variant_key:code.toLowerCase(),variant_code:code,color_name:color,color_hex:clean(f.get('color_hex'))||null,design_name:clean(f.get('design_name'))||null,price_per_unit:clean(f.get('price_per_unit'))?Number(f.get('price_per_unit')):p.price_per_unit,unit:p.unit,available_quantity:Number(f.get('available_quantity')||0),moq:Number(f.get('moq')||1),gtin:clean(f.get('gtin'))||null,status:'draft',approval_status:'pending'});if(r.error){alertMsg(r.error.message,'error');return}e.currentTarget.reset();e.currentTarget.hidden=true;alertMsg('Variant saved.','success');await load()};$('fts-toggle-catalog').onclick=()=>{$('fts-catalog-form').hidden=false};$('fts-cancel-catalog').onclick=()=>{$('fts-catalog-form').hidden=true};$('fts-catalog-form').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.currentTarget),r=await sb.from('seller_catalogs').insert({seller_id:seller.id,name:clean(f.get('name')),description:clean(f.get('description'))||null,status:clean(f.get('status'))||'draft',scope:clean(f.get('scope'))||'all_buyers',currency:clean(f.get('currency'))||'INR'});if(r.error){alertMsg(r.error.message,'error');return}e.currentTarget.reset();e.currentTarget.hidden=true;alertMsg('Catalogue created.','success');await load()};$('fts-toggle-category').onclick=()=>{$('fts-category-form').hidden=false};$('fts-cancel-category').onclick=()=>{$('fts-category-form').hidden=true};$('fts-category-form').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.currentTarget),r=await sb.from('seller_categories').insert({seller_id:seller.id,name:clean(f.get('name')),icon:clean(f.get('icon'))||null});if(r.error){alertMsg(r.error.message,'error');return}e.currentTarget.reset();e.currentTarget.hidden=true;alertMsg('Category saved.','success');await load()};$('fts-message-form').onsubmit=async e=>{e.preventDefault();if(!activeThread)return;const body=$('fts-message-input').value.trim();if(!body)return;const r=await sb.from('messages').insert({thread_id:activeThread.id,sender_id:session.user.id,sender_role:'seller',body});if(r.error){alertMsg(r.error.message,'error');return}$('fts-message-input').value='';await sb.from('message_threads').update({last_message:body,last_at:new Date().toISOString(),unread_buyer:(Number(activeThread.unread_buyer||0)+1),unread_seller:0}).eq('id',activeThread.id);await openThread(activeThread)};$('fts-request-payout').onclick=async()=>{if(!confirm('Request payout of all currently eligible seller balance?'))return;const r=await sb.rpc('request_my_seller_payout');if(r.error){alertMsg(r.error.message,'error');return}alertMsg(`Payout request created for ${money(r.data?.amount||0)}.`,'success');await load()};$('fts-toggle-shipment').onclick=()=>{$('fts-shipment-form').hidden=false};$('fts-cancel-shipment').onclick=()=>{$('fts-shipment-form').hidden=true};$('fts-shipment-form').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.currentTarget),orderId=clean(f.get('order_id'));if(!orderId)return;const {data:{session:s}}=await sb.auth.getSession();if(!confirm('Create a Shiprocket shipment for this paid order?'))return;alertMsg('Creating Shiprocket shipment…');const body={operationalOrderId:orderId,length:Number(f.get('length')),breadth:Number(f.get('breadth')),height:Number(f.get('height'))};if(clean(f.get('weight')))body.weight=Number(f.get('weight'));if(clean(f.get('courier_id')))body.courierId=clean(f.get('courier_id'));const r=await fetch('https://rdhfwlzhcvwjhkxhhpoo.supabase.co/functions/v1/shiprocket-create-shopify-shipment',{method:'POST',headers:{Authorization:`Bearer ${s.access_token}`,apikey:'sb_publishable_Un2-RQfjGbIiXF3Mb2oGIA_p-Z1kMls','Content-Type':'application/json'},body:JSON.stringify(body)});const p=await r.json();if(!r.ok){alertMsg(p.error||'Shipment creation failed.','error');return}e.currentTarget.hidden=true;alertMsg('Shipment created and Shopify fulfillment updated.','success');await load()};$('fts-mark-all-read').onclick=async()=>{await sb.from('commerce_notifications').update({is_read:true,read_at:new Date().toISOString()}).eq('user_id',session.user.id).eq('is_read',false);await loadNotifications()};$('fts-business-form').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.currentTarget),patch={display_name:clean(f.get('display_name'))||null,legal_business_name:clean(f.get('legal_business_name'))||null,business_type:clean(f.get('business_type'))||null,supply_tier:clean(f.get('supply_tier'))||null,moq_metres:clean(f.get('moq_metres'))?Number(f.get('moq_metres')):null,inventory_capacity_metres:clean(f.get('inventory_capacity_metres'))?Number(f.get('inventory_capacity_metres')):null};const r=await sb.from('seller_profiles').update(patch).eq('id',seller.id).select('*').single();if(r.error){alertMsg(r.error.message,'error');return}seller=r.data;alertMsg('Business profile saved.','success');renderAll()};$('fts-onboarding-form').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.currentTarget),phone=clean(f.get('phone'));const ph=await sb.rpc('set_current_account_phone',{p_phone:phone});if(ph.error){alertMsg(ph.error.message,'error');return}const payload={ownerName:clean(f.get('owner_name')),businessName:clean(f.get('business_name')),businessType:clean(f.get('business_type')),gstin:clean(f.get('gstin')).toUpperCase(),pan:clean(f.get('pan')).toUpperCase(),address:clean(f.get('address')),city:clean(f.get('city')),state:clean(f.get('state')),pincode:clean(f.get('pincode')),categories:clean(f.get('categories')).split(',').map(x=>x.trim()).filter(Boolean),monthlyCapacity:clean(f.get('monthly_capacity'))};const r=await sb.rpc('request_seller_access',{p_payload:payload});if(r.error){alertMsg(r.error.message,'error');return}alertMsg('Seller application submitted.','success');profile=await window.FabricTradAuth.refreshProfile();const sp=await sb.from('seller_profiles').select('*').eq('user_id',session.user.id).maybeSingle();seller=sp.data||seller;await load()}}
async function boot(){if(!window.FabricTradAuth){setTimeout(boot,60);return}profile=await window.FabricTradAuth.guard('seller');if(!profile)return;sb=await window.FabricTradAuth.getClient();const {data:{session:s}}=await sb.auth.getSession();session=s;const sp=await sb.from('seller_profiles').select('*').eq('user_id',session.user.id).maybeSingle();if(sp.error||!sp.data){throw new Error(sp.error?.message||'Seller profile was not found.')}seller=sp.data;wire();await load();$('fts-loading').hidden=true;document.querySelector('[data-ft-seller-workspace]').hidden=false;const q=new URLSearchParams(location.search).get('tab');tab(meta[q]?q:'overview',false)}boot().catch(e=>{$('fts-loading').innerHTML='<div style="padding:30px;text-align:center;color:#991b1b">'+String(e.message||'Seller workspace could not load.')+'</div>'});
})();
