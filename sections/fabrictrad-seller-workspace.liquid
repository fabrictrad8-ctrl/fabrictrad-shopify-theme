rea></label><label class="fts__wide">Categories<input name="categories" placeholder="Cotton, silk, suiting…"></label><label>Monthly capacity<input name="monthly_capacity"></label><div class="fts__wide fts__actions"><button class="fts__primary">Submit seller application</button></div></form><article class="ft-shopify-card fts__card" style="margin-top:13px"><div id="fts-kyc-host"><div class="fts__empty">Loading verification documents…</div></div></article></section>
</div></main></div></section>
<script>
(function(){
const $=id=>document.getElementById(id),money=n=>new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:2}).format(Number(n||0)),date=d=>d?new Intl.DateTimeFormat('en-IN',{dateStyle:'medium'}).format(new Date(d)):'—',dt=d=>d?new Intl.DateTimeFormat('en-IN',{dateStyle:'medium',timeStyle:'short'}).format(new Date(d)):'—',clean=v=>String(v??'').trim();let sb,session,profile,seller,registration,bank,products=[],variants=[],catalogs=[],categories=[],orders=[],items=[],requests=[],threads=[],disputes=[],settlements=[],payouts=[],billing=[],shipments=[],notifications=[],activeThread=null;
const meta={overview:['Home','Store health and next actions'],orders:['Orders','Accept, payment and fulfilment'],inventory:['Products','Listings and inventory'],upload:['Add product','AI-assisted catalogue creation'],variants:['Variants','Colours, designs and GTIN'],catalogs:['Catalogues & pricing','MOQ and buyer pricing'],categories:['Categories','Product organization'],requests:['Buyer requests','Open sourcing requirements'],inbox:['Inbox','Buyer conversations'],disputes:['Returns & disputes','Claims and resolutions'],earnings:['Earnings & payouts','Captured payments and settlements'],billing:['Invoices & documents','Automatic invoices and manual documents'],analytics:['Analytics','Sales and product performance'],fulfillment:['Shipments','Dispatch and tracking'],courier:['Shipping settings','Pickup and courier configuration'],notifications:['Notifications','Email and in-app alerts'],profile:['Business settings','GST, bank and store profile']};
